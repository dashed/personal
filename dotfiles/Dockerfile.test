# Dockerfile.test - Multi-stage build for comprehensive dotfiles testing using uv
# This provides a safe, isolated environment for testing core operations and safety features

ARG BASE_IMAGE=ubuntu:24.04
ARG VARIANT=default

# Stage 1: Base OS with Python 3.12
FROM ${BASE_IMAGE} as base
RUN apt-get update && apt-get install -y \
    python3 \
    python3-venv \
    python3-pip \
    git \
    curl \
    sudo \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Stage 2: Install uv and set up user
FROM base as uv-base
# Install uv directly
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

# Create test user (don't run as root for safety)
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers
USER testuser
WORKDIR /home/testuser

# Install uv for the test user
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/home/testuser/.local/bin:$PATH"

# Stage 3: Copy repository and install dependencies
FROM uv-base as deps
# Set uv environment variables for optimal Docker performance
ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy
ENV UV_PYTHON=python3

# Copy project files
COPY --chown=testuser:testuser pyproject.toml uv.lock* ./dotfiles/
WORKDIR /home/testuser/dotfiles

# Install dependencies using uv
RUN uv sync --frozen --no-install-project

# Copy the rest of the project
COPY --chown=testuser:testuser . ./

# Install the project itself
RUN uv sync --frozen

# Verify installation
RUN uv run dotfiles-sync --version

# Stage 4: Comprehensive integration testing
FROM deps as test
ARG VARIANT
ENV DOTFILES_VARIANT=${VARIANT}
ENV DOTFILES_TEST_MODE=true
ENV PATH="/home/testuser/dotfiles/.venv/bin:$PATH"

# Create test dotfiles in the repository
RUN mkdir -p test-dotfiles && \
    echo "# Test zshrc for ${VARIANT}" > test-dotfiles/test-zshrc && \
    echo "# Test gitconfig" > test-dotfiles/test-gitconfig && \
    echo "alias test-alias='echo testing'" > test-dotfiles/test-aliases

# Create a test configuration with safety features enabled
RUN printf '[package]\nname = "test-dotfiles"\nversion = "1.0.0"\nauthor = "Test User <test@example.com>"\n\n[safety]\ndry_run_default = true\nbackup_before_modify = true\nbackup_retention_days = 7\nverify_checksums = true\n\n[security]\nwhitelist_paths = ["/home/testuser/**", "/tmp/**"]\nblacklist_paths = ["/etc/**", "/root/**"]\nenable_command_whitelist = false\n\n[[step]]\nop = "link"\nsrc = "test-dotfiles/test-zshrc"\ndst = "~/.test-zshrc"\nvariants = ["all"]\n\n[[step]]\nop = "copy"\nsrc = "test-dotfiles/test-gitconfig"\ndst = "~/.test-gitconfig"\nvariants = ["all"]\n\n[[step]]\nop = "link"\nsrc = "test-dotfiles/test-aliases"\ndst = "~/.test-aliases"\nvariants = ["default", "personal"]\n' > test-config.toml

# Test dry run mode (should be safe)
RUN echo "=== Testing dry run ===" && \
    uv run dotfiles-sync --config test-config.toml sync && \
    echo "Dry run completed successfully"

# Test validation
RUN echo "=== Testing validation ===" && \
    uv run dotfiles-sync --config test-config.toml validate && \
    echo "Validation completed successfully"

# Verify no actual files were created (dry run)
RUN echo "=== Verifying dry run safety ===" && \
    ! test -f ~/.test-zshrc && \
    ! test -f ~/.test-gitconfig && \
    ! test -f ~/.test-aliases && \
    echo "Dry run safety verified - no files created"

# Create existing files to test backup functionality
RUN echo "=== Setting up backup test ===" && \
    mkdir -p ~/.config && \
    echo "# Original file to be backed up" > ~/.test-gitconfig && \
    echo "Testing backup creation..."

# Test actual application (in isolated container)
RUN echo "=== Testing actual application with safety features ===" && \
    uv run dotfiles-sync --config test-config.toml --apply sync && \
    echo "Application completed successfully"

# Verify files were created
RUN echo "=== Verifying file creation ===" && \
    test -L ~/.test-zshrc && \
    test -f ~/.test-gitconfig && \
    test -L ~/.test-aliases && \
    echo "File creation verified"

# Verify symlink targets
RUN echo "=== Verifying symlink targets ===" && \
    test "$(readlink ~/.test-zshrc)" = "/home/testuser/dotfiles/test-dotfiles/test-zshrc" && \
    test "$(readlink ~/.test-aliases)" = "/home/testuser/dotfiles/test-dotfiles/test-aliases" && \
    echo "Symlink targets verified"

# Verify backup was created
RUN echo "=== Verifying backup creation ===" && \
    if [ -d ~/.local/state/dotfiles/backups ]; then \
        echo "✓ Backup directory exists"; \
        ls -la ~/.local/state/dotfiles/backups/; \
    else \
        echo "⚠ Backup directory not found (may not be created for this test case)"; \
    fi

# Test safety validation with invalid config
RUN echo "=== Testing safety validation ===" && \
    printf '[package]\nname = "invalid-test"\nversion = "1.0.0"\n[security]\nwhitelist_paths = ["$HOME/**"]\nblacklist_paths = ["/etc/**"]\n[[step]]\nop = "copy"\nsrc = "test-dotfiles/test-gitconfig"\ndst = "/etc/invalid-file"\nvariants = ["all"]\n' > invalid-config.toml && \
    if uv run dotfiles-sync --config invalid-config.toml sync 2>/dev/null; then \
        echo "ERROR: Should have failed validation"; exit 1; \
    else \
        echo "✓ Safety validation working correctly"; \
    fi

# Test enhanced status command
RUN echo "=== Testing enhanced status ===" && \
    uv run dotfiles-sync status && \
    echo "Enhanced status command completed successfully"

# Create comprehensive test results
RUN printf '{"suite": "Comprehensive Integration Tests", "status": "SUCCESS", "tests": ["dry_run", "validation", "application", "file_creation", "symlink_verification", "backup_verification", "safety_validation", "enhanced_status"], "features": ["basic_operations", "safety_layer", "transaction_management", "backup_system", "path_validation"], "timestamp": "%s"}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > /tmp/test-results.json

# Final stage: Results and verification
FROM test as final
HEALTHCHECK --interval=5s --timeout=3s \
    CMD test -f /tmp/test-results.json

# Show results
RUN echo "=== Comprehensive Integration Test Results ===" && \
    cat /tmp/test-results.json

ENTRYPOINT ["cat", "/tmp/test-results.json"]